  nameOfNps: "\u041F\u0430\u0441\u0442\u0443\u0445"
  dialogue:
  - "\u0417\u0434\u0430\u0440\u043E\u0432\u0430 \u0411\u043E\u0431\u0435\u0440!"
  - "\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u0430 \u0442\u0432\u043E\u044F \u043F\u043E\u043C\u043E\u0449\u044C"
  - "\u041C\u043E\u0436\u0435\u0448\u044C \u0441\u043E\u0431\u0440\u0430\u0442\u044C
    \u0441\u0431\u0435\u0436\u0430\u0432\u0448\u0438\u0445 \u043A\u0443\u0440\u0438\u0446?"
  - "\u041E\u043D\u0438 \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C
    \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0435\u043A\u0443\n"
  - "\u0418\u0445 \u043D\u0443\u0436\u043D\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C
    4 \u0448\u0442\u0443\u043A\u0438"
  - "\u0417\u0430 \u044D\u0442\u043E \u044F \u0445\u043E\u0440\u043E\u0448\u043E
    \u0442\u0435\u0431\u044F \u043E\u0442\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E"
