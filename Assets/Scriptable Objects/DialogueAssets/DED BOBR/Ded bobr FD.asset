  m_Script: {fileID: 11500000, guid: fb6333995c15e4a4a8681deb12d6ac28, type: 3}
  m_Name: Ded bobr FD
  m_EditorClassIdentifier: 
  nameOfNps: "\u0414\u0435\u0434 \u0431\u043E\u0431\u0435\u0440"
  dialogue:
  - "\u0417\u0434\u043E\u0440\u043E\u0432\u0430 \u0432\u043D\u0443\u0447\u043E\u043A!
    \u041D\u0443 \u0447\u0442\u043E, \u0433\u043E\u0442\u043E\u0432 \u043F\u043E\u043C\u043E\u0447\u044C
    \u0434\u0435\u0434\u0443\u0448\u043A\u0435?"
  - "\u041C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043D\u0443\u0436\u043D\u043E
    \u0434\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E
    \u043F\u043B\u043E\u0442\u0438\u043D\u0443, \u043D\u043E \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
    5 \u0431\u0440\u0435\u0432\u0435\u043D"
  - "\u0411\u0443\u0434\u0435\u0442 \u0437\u0434\u043E\u0440\u043E\u0432\u043E, \u0435\u0441\u043B\u0438
    \u043F\u043E\u043C\u043E\u0436\u0435\u0448\u044C \u0434\u0435\u0434\u0443\u0448\u043A\u0435
    \u0432 \u043F\u043E\u0438\u0441\u043A\u0430\u0445"
  - "\u041F\u0435\u0440\u0432\u043E\u0435 \u0431\u0440\u0435\u0432\u043D\u043E \u043A\u0441\u0442\u0430\u0442\u0438
    \u043B\u0435\u0436\u0438\u0442 \u0432\u043E\u0437\u043B\u0435 \u0442\u0435\u043B\u0435\u0436\u043A\u0438,
    \u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
    \u043E\u0442\u044B\u0441\u043A\u0430\u0442\u044C \u0441\u0430\u043C\u043E\u043C\u0443"
